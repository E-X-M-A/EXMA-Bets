# --- Discord credentials (Developer Portal -> your application) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# The single server the bot operates in
DISCORD_GUILD_ID=

# --- Channels ---
# The only channel where users may run normal bot commands
BETTING_CHANNEL_ID=
# Channel where every new market is published with bet buttons
MARKET_ANNOUNCEMENT_CHANNEL_ID=

# --- Storage ---
DATABASE_PATH=./data/prediction-market.sqlite

# --- Economy (integers) ---
INITIAL_BALANCE=1000
DAILY_REWARD=200
MIN_BET=10
LEADERBOARD_PAGE_SIZE=10

# Daily rewards are distributed automatically at 00:00 in this IANA timezone
TIMEZONE=Europe/Berlin
# How many missed days (bot offline at midnight) are paid out on restart, including today
DAILY_MAX_BACKFILL_DAYS=7

# Optional: debug | info | warn | error
LOG_LEVEL=info
